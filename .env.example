# 复制为 .env 后填写：cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交到仓库。

# 必填：随机密钥。生成命令（服务器上执行）：
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# 或 openssl rand -base64 48
DJANGO_SECRET_KEY=请替换为随机字符串

# 必填：允许访问的主机名，逗号分隔。填入轻量服务器的【公网 IP】。
# 建议同时保留 localhost,127.0.0.1 便于服务器本机自检。
#   DJANGO_ALLOWED_HOSTS=123.45.67.89,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=请替换为公网IP,localhost,127.0.0.1

# 可选：CSRF 可信来源，逗号分隔且带 scheme。纯 HTTP 直连可留空。
# 若以后绑定域名：DJANGO_CSRF_ORIGINS=http://example.com
DJANGO_CSRF_ORIGINS=

# 可选：仅在已配置 HTTPS 时设为 1（会开启 HSTS、安全 Cookie、强制跳 HTTPS）。
# 纯 HTTP 访问必须保持 0，否则站点无法打开。
DJANGO_SECURE_SSL=0
